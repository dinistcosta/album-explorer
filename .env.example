# Copy to .env for local work (`cp .env.example .env`). Real environment variables win over .env.
# In production set these in the host's dashboard instead. Never commit real values.

# Off by default. Use DEBUG=1 locally only.
DEBUG=1

# Required when DEBUG is off (the app refuses to start without it). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated hostnames the site is served from (required in production).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins with scheme, e.g. https://albums.example.org (required behind HTTPS for the admin).
CSRF_TRUSTED_ORIGINS=

# Production database (PostgreSQL). Unset = local SQLite file db.sqlite3.
#   postgres://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=

# Optional API keys. Without them the site still works: Last.fm liner-note fallback, genre
# descriptions and genre rooms are skipped, and Discogs links/marketplace data are omitted.
LASTFM_API_KEY=
DISCOGS_TOKEN=

# Contact link sent in the User-Agent to MusicBrainz and friends (a project page or an
# address of your choice; MusicBrainz asks for a way to reach you).
CONTACT_URL=

# Optional: set to 0 if the host health-checks over plain HTTP (default 1 redirects to HTTPS).
SECURE_SSL_REDIRECT=1
# Optional: log level (default INFO).
LOG_LEVEL=INFO
